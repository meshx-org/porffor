	"defines": ["_FILE_OFFSET_BITS=64", "_LARGEFILE_SOURCE"],
	"includes": ["include", "src"],
	"headers": "include",
	"platforms": {
		"darwin": {
			"sources": [
				"src/unix/bsd-ifaddrs.c",
