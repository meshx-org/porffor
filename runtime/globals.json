		{
			"file": "abort.mjs",
			"names": ["AbortController", "AbortSignal", "DOMException"]
		},
		{
			"file": "readable-stream.mjs",
			"names": ["ReadableStream", "ReadableStreamDefaultReader", "ReadableStreamDefaultController"]
		},
		{
			"file": "readable-byte-stream.mjs",
			"names": [
				"ReadableByteStreamController",
				"ReadableStreamBYOBReader",
				"ReadableStreamBYOBRequest"
			],
			"why": "byte streams plug into ReadableStream when loaded: a program gets them when it names one of these or asks for one (load: type 'bytes', mode 'byob'); others have default streams only",
			"load": "type\\s*:\\s*['\"]bytes['\"]|mode\\s*:\\s*['\"]byob['\"]"
		},
		{
			"file": "readable-stream-iteration.mjs",
			"names": [],
			"trigger": [
