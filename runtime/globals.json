			"about": "TextDecoder's label: an encoding other than UTF-8 is its own module (its tables). A label the analysis cannot see (read from a Content-Type, a parameter) brings every encoding; FileReader.readAsText decodes by the blob's charset, which is data",
			"caseInsensitive": true,
			"trim": true,
			"sites": [
				{
					"new": "TextDecoder",
					"argument": 0
				},
				{
					"new": "TextDecoderStream",
					"argument": 0
				},
				{
					"method": ["readAsText"],
					"dynamic": true
				}
			],
			"variants": "every legacy text encoding and its tables"
		},
		"webcrypto-algorithm": {
			"about": "A Web Crypto algorithm, a string or an object's name (and its hash, a string or { name }): each family is its own module. An algorithm the analysis cannot see brings every family",
			"caseInsensitive": true,
			"objectKeys": ["name", "hash"],
			"sites": [
				{
					"method": [
						"encrypt",
						"decrypt",
						"sign",
						"verify",
						"digest",
						"generateKey",
						"deriveBits",
						"encapsulateBits",
						"decapsulateBits"
					],
					"receiver": "subtle",
					"argument": 0
				},
				{
					"method": ["importKey"],
					"receiver": "subtle",
					"argument": 2
				},
				{
					"method": ["deriveKey"],
					"receiver": "subtle",
					"argument": [0, 2]
				},
				{
					"method": ["wrapKey"],
					"receiver": "subtle",
					"argument": 3
				},
				{
					"method": ["unwrapKey"],
					"receiver": "subtle",
					"argument": [3, 4]
				},
				{
					"method": ["encapsulateKey"],
					"receiver": "subtle",
					"argument": [0, 2]
				},
				{
					"method": ["decapsulateKey"],
					"receiver": "subtle",
					"argument": [0, 3]
				},
				{
					"method": ["supports"],
					"receiver": "SubtleCrypto",
					"argument": [1, 2]
				}
			],
			"variants": "every Web Crypto algorithm (AES, EC, RSA, post-quantum...)"
		},
		"compression-format": {
			"about": "CompressionStream's and DecompressionStream's format: a format that needs more than the deflater and inflater (brotli) is its own module",
			"sites": [
				{
					"new": "CompressionStream",
					"argument": 0
				},
				{
					"new": "DecompressionStream",
					"argument": 0
				}
			],
			"variants": "every compression format"
		}
	}
