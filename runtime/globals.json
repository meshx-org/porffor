				"fetch",
				"Request",
				"Response",
				"Blob",
				"File",
				"body",
				"readable",
				"stream"
			],
			"why": "async iteration of a ReadableStream and ReadableStream.from plug into ReadableStream when loaded (some 16 KB): a program gets them when it may have a stream (trigger) and iterates one (load: for await, Symbol.asyncIterator, values(), from(), Array.fromAsync)",
			"load": "for\\s+await\\b|Symbol\\.asyncIterator|\\.values\\s*\\(|\\.from\\s*\\(|fromAsync"
		},
